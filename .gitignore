# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/.release-*/

# misc
.DS_Store
# Environment-specific configuration. Only the documented template may be
# versioned; React variables can still expose sensitive operational metadata.
.env
.env.*
!.env.example

# Private keys and credential exports never belong in the web repository.
*.key
*.pem
*.p12
*.pfx
*credentials*.json
*service-account*.json

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local verification artifacts
/tmp/
